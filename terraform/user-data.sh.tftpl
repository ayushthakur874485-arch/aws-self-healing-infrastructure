#!/bin/bash
set -euxo pipefail
exec > /var/log/user-data.log 2>&1

dnf install -y python3 python3-pip amazon-cloudwatch-agent

id appuser &>/dev/null || useradd --system --no-create-home --shell /sbin/nologin appuser
mkdir -p /opt/self-healing-app /var/log/demo-app

python3 -m venv /opt/self-healing-app/venv
/opt/self-healing-app/venv/bin/pip install "Flask==3.1.3"

echo '${app_py_b64}' | base64 -d | tr -d '\r' > /opt/self-healing-app/app.py
echo '${service_b64}' | base64 -d | tr -d '\r' > /etc/systemd/system/demo-app.service
chown -R appuser:appuser /opt/self-healing-app /var/log/demo-app
chmod 644 /opt/self-healing-app/app.py

systemctl daemon-reload
systemctl enable --now demo-app

echo '${cw_b64}' | base64 -d | tr -d '\r' > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

systemctl restart amazon-ssm-agent