[Unit]
Description=Self Healing Infrastructure Demo Application
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/self-healing-app
ExecStart=/opt/self-healing-app/venv/bin/python /opt/self-healing-app/app.py
Restart=no
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
